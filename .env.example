# Copie ce fichier en .env.local pour le développement local,
# et renseigne les mêmes variables dans Vercel pour la production.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Une chaîne aléatoire longue, utilisée pour signer les cookies de session.
# Génère-en une avec : openssl rand -base64 32
SESSION_SECRET=change-moi
